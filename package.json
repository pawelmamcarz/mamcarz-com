{
  "name": "mamcarz-com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static site for mamcarz.com. The worker/ subfolder holds the Cloudflare Worker for the AI chat.",
  "scripts": {
    "optimize:images": "node scripts/optimize-images.js",
    "verify:site": "node scripts/verify-site.mjs --scope=all",
    "verify:facts": "node scripts/verify-site.mjs --scope=facts",
    "verify:foundation": "node scripts/verify-site.mjs --scope=foundation",
    "verify:home": "node scripts/verify-site.mjs --scope=home",
    "verify:pages": "node scripts/verify-site.mjs --scope=pages",
    "verify:metadata": "node scripts/verify-site.mjs --scope=metadata",
    "verify:discovery": "node scripts/verify-site.mjs --scope=discovery",
    "verify:seo": "node scripts/verify-site.mjs --scope=seo",
    "test:verify-site": "node --test scripts/verify-site.test.mjs",
    "test:worker": "node --test worker/index.test.mjs"
  },
  "devDependencies": {
    "sharp": "^0.33.5"
  }
}
